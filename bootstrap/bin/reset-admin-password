#!/usr/bin/env bash
# Local-only Bootstrap admin password reset -- run on the server itself,
# with root/sudo (the same access install.sh already requires). This
# wrapper only resolves paths and invokes the venv's python3 (werkzeug for
# password hashing lives there, not in the system python3); the actual
# logic is in the sibling reset_admin_password.py, which is also directly
# unit-testable without root or a TTY.
#
# Usage:
#   sudo /opt/mesflow-bootstrap/bin/reset-admin-password
#   sudo /opt/mesflow-bootstrap/bin/reset-admin-password --username newadmin
set -Eeuo pipefail

BOOTSTRAP_HOME="${MESFLOW_BOOTSTRAP_HOME:-/opt/mesflow-bootstrap}"
PY="$BOOTSTRAP_HOME/.venv/bin/python3"

if [[ ! -x "$PY" ]]; then
  echo "ERROR: $PY not found -- is Bootstrap installed on this host? (sudo bash install.sh)" >&2
  exit 1
fi

exec "$PY" "$BOOTSTRAP_HOME/bin/reset_admin_password.py" "$@"

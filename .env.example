AGENT_BIND_IP=127.0.0.1
AGENT_PORT=8090
MESFLOW_QA_PROFILE=LOCAL
MESFLOW_QA_INTERNAL_URL=http://mesflow-app:8080
MESFLOW_QA_USERNAME=admin
